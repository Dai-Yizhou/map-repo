{
  "id": "gilded-america",
  "version": "2.0.0",
  "name": { "zh-CN": "镀金年代·美国大城", "en-US": "Gilded America" },

  "_comment": "UCT 字段全集：声明本图允许使用的数值字段；格子里的 UCT 只能出现这些键（字段 id/name/scope/min/max，不含 current；初值来自 playerInitial 与 regions[].initial）。",

  "valueFieldDefinitions": [
    { "id": "money",     "name": { "zh-CN": "财产", "en-US": "Money" },      "scope": "player", "min": 0 },
    { "id": "credit",    "name": { "zh-CN": "信用", "en-US": "Credit" },     "scope": "player", "min": 0 },
    { "id": "reputation","name": { "zh-CN": "声望", "en-US": "Reputation" }, "scope": "player", "min": 0, "max": 100 },
    { "id": "pros",      "name": { "zh-CN": "繁荣", "en-US": "Prosperity" }, "scope": "region", "min": 0, "max": 100 }
  ],
  "uct": { "player": ["money", "credit", "reputation"], "region": ["pros"] },

  "playerInitial": { "player": { "money": 1000, "credit": 50, "reputation": 0 } },
  "startCellId": 0,

  "regions": [
    { "id": "r1", "name": { "zh-CN": "市中心·金融区", "en-US": "Financial District" }, "initial": { "region": { "pros": 45 } } },
    { "id": "r2", "name": { "zh-CN": "工业区", "en-US": "Industrial District" },       "initial": { "region": { "pros": 55 } } },
    { "id": "r3", "name": { "zh-CN": "铁路与港埠", "en-US": "Railroad & Harbor" },      "initial": { "region": { "pros": 50 } } },
    { "id": "r4", "name": { "zh-CN": "移民聚居街区", "en-US": "Neighborhoods" },        "initial": { "region": { "pros": 45 } } },
    { "id": "r5", "name": { "zh-CN": "郊野与都会边缘", "en-US": "Outskirts" },         "initial": { "region": { "pros": 35 } } }
  ],

  "dayNightCycle": 30,
  "dice": { "cooldownMs": 3000, "min": 1, "max": 3 },
  "tax": {
    "baseTax": {
      "rates":       { "player": { "money": 0.02, "credit": 0.01 } },
      "exemptBelow": { "player": { "money": 1000 } },
      "taxInterval": 900000
    },
    "shareTax": {
      "rates":       { "player": { "money": 10 } },
      "exemptBelow": 0,
      "taxInterval": 900000
    }
  }
}